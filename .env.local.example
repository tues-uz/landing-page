# ── Landing Page Local Development Config ──────────────────────────────
# Remote TUES platform API (kubeletto)
VITE_API_BASE_URL=https://tues.kubeletto.app/api/v1

# Local Java API (alternative)
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Bypass login when the remote API is unavailable (local CMS UI only)
# VITE_CMS_SKIP_AUTH=true

# Use local blob URLs for cover/carousel/editor images (no media API). Auto-fallback also runs when upload returns 500.
# VITE_CMS_DEMO_MEDIA=true
